{
  "Comment": "Export an OpenSearch dataset to S3",
  "StartAt": "InitializeExport",
  "States": {
    "InitializeExport": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${initialize_export_lambda_arn}",
        "Payload": {
          "request.$": "$",
          "executionId.$": "$$.Execution.Id"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 4,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": [
            "TemporaryOpenSearchError"
          ],
          "IntervalSeconds": 5,
          "BackoffRate": 2,
          "MaxAttempts": 5,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "ExportAlreadyExists"
    },
    "ExportAlreadyExists": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.alreadyExists",
          "BooleanEquals": true,
          "Next": "ReturnExistingExport"
        }
      ],
      "Default": "ExportSlices"
    },
    "ReturnExistingExport": {
      "Type": "Succeed"
    },
    "ExportSlices": {
      "Type": "Map",
      "ItemsPath": "$.slices",
      "MaxConcurrency": ${max_concurrency},
      "ItemSelector": {
        "requestId.$": "$.requestId",
        "exportId.$": "$.exportId",
        "pitId.$": "$.pitId",
        "indexName.$": "$.indexName",
        "query.$": "$.query",
        "pageSize.$": "$.pageSize",
        "bucket.$": "$.bucket",
        "sliceId.$": "$$.Map.Item.Value.sliceId",
        "sliceCount.$": "$$.Map.Item.Value.sliceCount",
        "pageNumber": 0,
        "searchAfter": null,
        "totalDocuments": 0,
        "totalFiles": 0
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "StartSliceWorkflow",
        "States": {
          "StartSliceWorkflow": {
            "Type": "Task",
            "Resource": "arn:aws:states:::states:startExecution.sync:2",
            "Parameters": {
              "StateMachineArn": "${slice_state_machine_arn}",
              "Input.$": "$"
            },
            "OutputPath": "$.Output",
            "Retry": [
              {
                "ErrorEquals": [
                  "StepFunctions.ExecutionLimitExceeded"
                ],
                "IntervalSeconds": 5,
                "BackoffRate": 2,
                "MaxAttempts": 5,
                "JitterStrategy": "FULL"
              }
            ],
            "End": true
          }
        }
      },
      "ResultPath": "$.sliceResults",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "CleanupFailedExport"
        }
      ],
      "Next": "CleanupSuccessfulExport"
    },
    "CleanupSuccessfulExport": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${cleanup_export_lambda_arn}",
        "Payload": {
          "requestId.$": "$.requestId",
          "exportId.$": "$.exportId",
          "pitId.$": "$.pitId",
          "outcome": "SUCCESS"
        }
      },
      "ResultPath": "$.cleanup",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "TemporaryOpenSearchError"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 5,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "CleanupFailedExport"
        }
      ],
      "Next": "FinalizeExport"
    },
    "FinalizeExport": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${finalize_export_lambda_arn}",
        "Payload": {
          "requestId.$": "$.requestId",
          "exportId.$": "$.exportId",
          "indexName.$": "$.indexName",
          "bucket.$": "$.bucket",
          "outputPrefix.$": "$.outputPrefix",
          "startedAt.$": "$.startedAt",
          "sliceCount.$": "$.sliceCount",
          "sliceResults.$": "$.sliceResults"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 4,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "CleanupFailedExport"
        }
      ],
      "Next": "ExportCompleted"
    },
    "CleanupFailedExport": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${cleanup_export_lambda_arn}",
        "Payload": {
          "requestId.$": "$.requestId",
          "exportId.$": "$.exportId",
          "pitId.$": "$.pitId",
          "outcome": "FAILURE",
          "error.$": "$.error"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "TemporaryOpenSearchError"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 5,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "ExportFailed"
    },
    "ExportCompleted": {
      "Type": "Succeed"
    },
    "ExportFailed": {
      "Type": "Fail",
      "Error": "OpenSearchExportFailed",
      "Cause": "One or more export operations failed"
    }
  }
}